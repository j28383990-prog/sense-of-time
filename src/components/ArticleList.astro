---
const { articles } = Astro.props;


const sortedArticles = [...articles].sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);



const groupedArticles = sortedArticles.reduce(
  (acc, article) => {

    const year = article.data.date.substring(0, 4);


    if (!acc[year]) {

      acc[year] = [];

    }


    acc[year].push(article);


    return acc;

  },
  {}
);

---


<div class="archive">


{
  Object.entries(groupedArticles).map(
    ([year, items]) => (

      <section class="year">


        <h3>
          {year}
        </h3>



        {
          items.map(
            (article, index) => (

              <a
                class="entry"
                href={`/article/${article.id}`}
              >


                {
                  article.data.image && (

                    <div class="thumbnail">

                      <img
                        src={article.data.image}
                        alt={article.data.title}
                      />

                    </div>

                  )
                }



                <div class="number">

                  {
                    String(index + 1)
                    .padStart(2, "0")
                  }

                </div>




                <div class="content">


                  <h2>
                    {article.data.title}
                  </h2>



                  <p>
                    {article.data.description}
                  </p>



                  <span>
                    {article.data.date}
                  </span>


                </div>


              </a>


            )
          )
        }


      </section>

    )
  )
}


</div>





<style>


.archive {


display:flex;


flex-direction:column;


gap:90px;


}





.year h3 {


font-family:

Arial,
Helvetica,
sans-serif;


font-size:12px;


font-weight:400;


letter-spacing:6px;


color:#999;


margin-bottom:40px;


}






.entry {


