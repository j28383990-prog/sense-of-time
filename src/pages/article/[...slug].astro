---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";


export async function getStaticPaths() {

  const articles = await getCollection("articles");

  return articles.map((article) => ({
    params: {
      slug: article.id
    },
    props: {
      article
    }
  }));

}


const { article } = Astro.props;

const { Content } = await render(article);

const category = article.id.split("/")[0];

---


<Layout title={article.data.title}>


<article class="article">


  <header class="article-header">


    <div class="category">
      {category}
    </div>


    <h1>
      {article.data.title}
    </h1>


    <p class="description">
      {article.data.description}
    </p>


    <div class="date">
      {article.data.date}
    </div>


  </header>



  <div class="divider"></div>



  <div class="article-content">

    <Content />

  </div>



  <div class="article-footer">

    <a href={`/${category}`}>
      ← Back to {category}
    </a>

  </div>


</article>


</Layout>



<style>


.article {

  max-width: 900px;

  margin: 0 auto;

  padding: 100px 40px 140px;

}



/* =========================
   Article Header
========================= */


.article-header {

  text-align: center;

  max-width: 760px;

  margin: 0 auto;

}



.category {

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;

  letter-spacing: 7px;

  text-transform: uppercase;

  color: #777;

  margin-bottom: 35px;

}



.article-header h1 {

  font-family:
    "Times New Roman",
    serif;

  font-size: 72px;

  font-weight: 400;

  font-style: italic;

  line-height: 1.05;

  letter-spacing: -1px;

  margin: 0;

}



.description {

  max-width: 600px;

  margin: 35px auto 0;

  font-size: 17px;

  line-height: 1.8;

  color: #666;

}



.date {

  margin-top: 30px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;

  letter-spacing: 4px;

  color: #999;

}



/* =========================
   Divider
========================= */


.divider {

  width: 100%;

  height: 1px;

  background: #ddd;

  margin: 90px 0;

}



/* =========================
   Article Content
========================= */


.article-content {

  max-width: 720px;

  margin: 0 auto;

  font-family:
    "Times New Roman",
    serif;

  font-size: 20px;

  line-height: 1.9;

  color: #222;

}



.article-content :global(p) {

  margin: 0 0 35px;

}



.article-content :global(h1) {

  font-family:
    "Times New Roman",
    serif;

  font-size: 42px;

  font-weight: 400;

  line-height: 1.2;

  margin: 70px 0 30px;

}



.article-content :global(h2) {

  font-family:
    "Times New Roman",
    serif;

  font-size: 34px;

  font-weight: 400;

  line-height: 1.3;

  margin: 60px 0 25px;

}



.article-content :global(h3) {

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 15px;

  font-weight: 500;

  letter-spacing: 2px;

  margin: 50px 0 20px;

}



.article-content :global(ul),

.article-content :global(ol) {

  margin: 30px 0;

  padding-left: 30px;

}



.article-content :global(li) {

  margin-bottom: 12px;

}



.article-content :global(blockquote) {

  margin: 60px 0;

  padding: 20px 0 20px 30px;

  border-left: 2px solid #111;

  color: #666;

  font-style: italic;

}



.article-content :global(a) {

  color: #111;

  text-decoration: underline;

  text-underline-offset: 4px;

}



.article-content :global(img) {

  display: block;

  width: 100%;

  height: auto;

  margin: 60px 0;

}



.article-content :global(figure) {

  margin: 60px 0;

}



.article-content :global(figcaption) {

  margin-top: 12px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;

  line-height: 1.5;

  letter-spacing: 1px;

  color: #888;

}



.article-content :global(hr) {

  border: none;

  border-top: 1px solid #ddd;

  margin: 70px 0;

}



/* =========================
   Article Footer
========================= */


.article-footer {

  max-width: 720px;

  margin: 100px auto 0;

  padding-top: 30px;

  border-top: 1px solid #ddd;

}



.article-footer a {

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 11px;

  letter-spacing: 3px;

  text-transform: uppercase;

  text-decoration: none;

  color: #666;

  transition: color .3s ease;

}



.article-footer a:hover {

  color: #111;

}



/* =========================
   Mobile
========================= */


@media (max-width: 900px) {


  .article {

    padding: 70px 25px 100px;

  }


  .article-header h1 {

    font-size: 52px;

  }


  .description {

    font-size: 16px;

  }


  .divider {

    margin: 65px 0;

  }


  .article-content {

    font-size: 18px;

    line-height: 1.85;

  }


  .article-content :global(h1) {

    font-size: 34px;

  }


  .article-content :global(h2) {

    font-size: 28px;

  }


}
</style>