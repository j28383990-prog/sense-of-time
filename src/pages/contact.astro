---
import Layout from "../layouts/Layout.astro";
---


<Layout title="Contact">


<main>


<section class="contact">


<h1>
CONTACT
</h1>



<div class="intro">


<p>
A place for conversations,
<br>
collaborations,
<br>
and shared perspectives.
</p>


</div>





<div class="info">



<div class="item">


<h2>
Email
</h2>


<p>
your@email.com
</p>


</div>





<div class="item">


<h2>
Instagram
</h2>


<p>
@yourname
</p>


</div>





<div class="item">


<h2>
Based in
</h2>


<p>
Japan
</p>


</div>




</div>



</section>


</main>


</Layout>






<style>


main {


max-width:900px;


margin:120px auto;


padding:0 40px;


}




.contact {


min-height:70vh;


}



h1 {


font-family:

"Times New Roman",
serif;


font-size:90px;


font-weight:400;


font-style:italic;


letter-spacing:2px;


margin:0 0 80px;


}





.intro {


margin-bottom:120px;


}



.intro p {


font-size:26px;


line-height:1.8;


font-family:

"Times New Roman",
serif;


font-style:italic;


}





.info {


border-top:1px solid #ddd;


}





.item {


padding:35px 0;


border-bottom:1px solid #ddd;


display:flex;


justify-content:space-between;


align-items:center;


}





.item h2 {


font-size:14px;


font-family:

Arial,
Helvetica,
sans-serif;


letter-spacing:5px;


font-style:normal;


margin:0;


font-weight:400;


}





.item p {


font-size:18px;


margin:0;


color:#555;


}





@media(max-width:700px){


main {


padding:0 25px;


}




h1 {


font-size:60px;


}



.intro p {


font-size:22px;


}



.item {


display:block;


}



.item p {


margin-top:15px;


}


}



</style>