---
import Layout from "../layouts/Layout.astro";
---


<Layout title="A Sense of Time">



<section class="hero">


<h1>
A Sense
<br>
of Time
</h1>



<p>
Stories about movement,heritage and everyday essence.
</p>


</section>





<section class="categories">



<a href="/motion" class="card motion">


<img src="/images/categories/motion.jpg" />


<div class="overlay"></div>



<div class="content">


<span>
01
</span>



<h2>
MOTION
</h2>



<p>
Machines.
<br>
Movement.
<br>
Mechanical poetry.
</p>


</div>


</a>





<a href="/heritage" class="card heritage">


<img src="/images/categories/heritage.jpg" />


<div class="overlay"></div>



<div class="content">


<span>
02
</span>



<h2>
HERITAGE
</h2>



<p>
Objects with memories.
<br>
Craftsmanship.
<br>
History preserved.
</p>


</div>


</a>





<a href="/essence" class="card essence">


<img src="/images/categories/essence.jpg" />


<div class="overlay"></div>



<div class="content">


<span>
03
</span>



<h2>
ESSENCE
</h2>



<p>
The beauty of ordinary moments.
<br>
Objects.
<br>
Spaces.
<br>
Human experience.
</p>


</div>


</a>



</section>



</Layout>





<style>


.hero {


text-align:center;


padding-top:120px;


padding-bottom:150px;


animation:fadeUp 1.2s ease forwards;


}





.hero h1 {


font-family:"Times New Roman",serif;


font-size:120px;


font-weight:400;


font-style:italic;


line-height:.95;


letter-spacing:-3px;


margin:0;


opacity:0;


animation:fadeUp 1s .2s ease forwards;


}





.hero p {


margin-top:45px;


font-size:12px;


letter-spacing:10px;


color:#777;


opacity:0;


animation:fadeUp 1s .5s ease forwards;


}







.categories {


display:grid;


grid-template-columns:repeat(3,1fr);


gap:35px;


padding:0 60px 120px;


}







.card {


height:520px;


position:relative;


overflow:hidden;


text-decoration:none;


color:white;


display:block;


opacity:0;


animation:fadeUp 1s ease forwards;


}





.motion {


animation-delay:.4s;


}





.heritage {


animation-delay:.6s;


}





.essence {


animation-delay:.8s;


}







.card img {


width:100%;


height:100%;


object-fit:cover;


transition:transform 1s ease;


}





.card:hover img {


transform:scale(1.08);


}







.overlay {


position:absolute;


inset:0;


background:

linear-gradient(

to top,

rgba(0,0,0,.65),

rgba(0,0,0,.15)

);


}







.content {


position:absolute;


left:0;


right:0;


bottom:70px;


text-align:center;


}





.content span {


font-size:12px;


letter-spacing:5px;


opacity:.7;


}






h2 {


font-family:"Times New Roman",serif;


font-size:60px;


font-weight:400;


font-style:italic;


margin:25px 0;


}







.content p {


font-size:13px;


letter-spacing:3px;


line-height:2;


margin:0;


opacity:.85;


}







@keyframes fadeUp {


from {


opacity:0;


transform:translateY(40px);


}



to {


opacity:1;


transform:translateY(0);


}


}








@media(max-width:900px){


.hero h1 {


font-size:70px;


}





.categories {


grid-template-columns:1fr;


padding:0 25px 80px;


}


}


</style>